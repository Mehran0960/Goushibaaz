{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goushibaaz-trend-scout",
  "main": "src/index.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "goushibaaz-trend-db",
      "database_id": "57933d3e-60ff-4c11-a112-6d379315fe1f",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "YT_REGION_CODE": "IR"
  }
}
