{
  "schema_version": 2,
  "project": "Goushibaaz / گوشی‌باز",
  "content_focus": {
    "primary_language": "Persian (fa)",
    "primary_market": "Iran",
    "preferred_topics": [
      "All discoverable subjects, including current affairs, politics, economics, science, health, education, sport, culture, religion, arts, entertainment and practical topics",
      "Persian-language and Iran-relevant material where supported by source metadata",
      "Original or creator-authorized material with clear, verifiable reuse rights"
    ],
    "prioritize_original_or_creator_authorized_material": true,
    "deprioritized_topics": [],
    "topic_based_exclusions": []
  },
  "vertical_video": {
    "output_width": 1080,
    "output_height": 1920,
    "aspect_ratio": "9:16",
    "aspect_ratio_numeric": 0.5625,
    "prefer_source_portrait": true,
    "accept_unknown_source_dimensions_for_discovery": true,
    "transcode_all_published_videos_to_output_ratio": true,
    "allow_landscape_with_blurred_background": true,
    "portrait_preferred_but_not_mandatory": true,
    "allowed_source_aspect_ratio_range": [
      0.45,
      2
    ]
  },
  "ranking_order": [
    "verified candidate-level play-count acceleration",
    "candidate-level view-count acceleration only when play acceleration is unavailable",
    "source-backed editorial quality and clear subject",
    "freshness and format suitability",
    "measured trend demand and local relevance",
    "category diversity"
  ],
  "rights_gate": {
    "require_verified_republication_rights": true,
    "accepted_licenses": [
      "CC0 1.0",
      "CC BY 4.0",
      "CC BY-SA 4.0"
    ],
    "explicit_creator_permission_also_allowed": true,
    "public_visibility_or_cc_search_filter_alone_is_permission": false,
    "unverified_sources_are_discovery_only": true,
    "unknown_rights_are_not_explicit_prohibition": true,
    "retain_unverified_candidates_in_discovery_ranking": true,
    "unverified_candidates_are_not_auto_publishable": true,
    "explicit_republication_prohibition_blocks_publication": true,
    "restricted_licenses_block_automated_adaptation": true
  },
  "platform_profiles": {
    "filo": {
      "output_width": 720,
      "output_height": 1280,
      "cover_width": 720,
      "cover_height": 1280,
      "recommended_resolution": "720p",
      "rationale": "Filo's creator guidance recommends 720p video and a relevant, high-quality cover.",
      "end_card_seconds": 1.6,
      "end_card_message": "For more videos, follow Goushibaaz on Filo"
    }
  },
  "audience_priority_weights": {
    "persian_comedy": 20,
    "surprise_reveal": 20,
    "human_reaction": 20,
    "sports_skill": 20,
    "satisfying_craft": 20,
    "life_hacks": 20,
    "science_tech": 20,
    "performance_magic": 20,
    "food_cooking": 20,
    "heartwarming": 20,
    "diy_creativity": 20,
    "pets_animals": 20,
    "home_cleaning": 20,
    "travel_culture": 20,
    "fashion_culture": 20,
    "nature_wildlife": 20,
    "general_entertainment": 20,
    "technology_demo": 20,
    "news_current_affairs": 20,
    "economy_finance": 20,
    "society_law": 20,
    "health_medicine": 20,
    "education_books": 20,
    "film_media_art": 20,
    "music_audio": 20,
    "religion_philosophy": 20,
    "environment_climate": 20,
    "history_politics": 20,
    "transport_energy": 20
  },
  "video_processing": {
    "output_mode": "9:16",
    "aspect_fill_mode": "fit_foreground_with_blurred_background",
    "never_crop_foreground": true,
    "require_source_audio": true,
    "preserve_source_audio": true,
    "audio_codec": "AAC",
    "audio_bitrate": "96k"
  },
  "source_policy": {
    "nasa_public_media_enabled_for_public_entertainment": false,
    "external_reuse_requires_item_level_license": true,
    "accepted_licenses": [
      "CC0 1.0",
      "CC BY 4.0",
      "CC BY-SA 4.0"
    ],
    "trend_source_is_discovery_only": true
  },
  "topic_weight_policy": "neutral_default_equal_weight; measured candidate acceleration and source quality determine selection"
}
